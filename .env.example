# Copy to .env. Never commit the real file.

# Claude API key. Running the example spends tokens.
ANTHROPIC_API_KEY=

# Cleat API key, from workspace settings. Create it scoped to ONE line and with
# an expiry date — that is what makes it safe to hand to an agent.
CLEAT_API_KEY=clt_your_api_key

# The one line the agent may read.
CLEAT_LINE_ID=00000000-0000-0000-0000-000000000000

# Where the agent may submit the code: the sign-in YOU started, on YOUR account.
# The agent cannot choose or change this. Leave it empty and the agent will
# refuse to submit anything and will report the code to you instead.
SIGN_IN_CALLBACK_URL=
